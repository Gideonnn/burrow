{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["BURROW_*", "FORCE_COLOR"]
    },
    // No lint/format task: oxlint and oxfmt run once from the root over the
    // whole workspace, which is faster than turbo scheduling a task per package.
    // Tests and typechecks read workspace packages as TS source, so a
    // dependency's files must reach the cache key. `transit` has no script: it
    // only chains hashes through the graph without adding ordering.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    }
  }
}

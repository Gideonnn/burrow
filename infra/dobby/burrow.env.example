# What burrow.env.enc holds, as plaintext keys. Edit the real file with:
#   sops --input-type dotenv --output-type dotenv infra/dobby/burrow.env.enc

# pnpm --filter @burrow/server cli generate-secret
BURROW_SECRET_KEY=

# Dobby's Tailscale HTTPS name, e.g. https://dobby.<tailnet>.ts.net
BURROW_PUBLIC_URL=

BURROW_LANGUAGE=Dutch

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Copy to .env next to this file for local development. Never commit .env.

# 32 random bytes, base64: pnpm --filter @burrow/server cli generate-secret
BURROW_SECRET_KEY=

# Where the database lives (created if missing).
BURROW_DATA_DIR=.data

# The address a browser uses to reach this server; OAuth redirects go to
# <BURROW_PUBLIC_URL>/oauth/callback. Locally the default is fine.
# BURROW_PUBLIC_URL=http://127.0.0.1:4717

# Google Cloud OAuth client (type "Web application"); see the providers topic.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app registration; see the providers topic.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
